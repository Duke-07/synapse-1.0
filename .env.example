# ==========================================
# Synapse-Voice Environment Configuration
# Copy this file to .env and supply your credentials.
# NEVER commit sensitive API keys or secrets to git.
# ==========================================

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com

# --- Real Email OTP Verification Configuration ---
# Choose ONE of the following options to send real OTP emails to mail:

# Option 1: Resend (RECOMMENDED - Instant, 3,000 free emails/month, highest deliverability)
# Get a free API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Synapse-Voice

# Option 2: Gmail SMTP (Use standard Gmail address + 16-character Google App Password)
# Generate App Password: myaccount.google.com -> Security -> 2-Step Verification -> App Passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_SSL=false

# Option 3: Brevo / SendGrid / Custom SMTP
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Auth & JWT Security ---
JWT_SECRET=synapse-voice-secret-key-epics-2026-screening-platform
JWT_EXPIRE_MINUTES=10080

# --- LLM & RAG Configuration ---
# Choose 'gemini' (default) or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase Database, pgvector & Storage ---
# (If not provided, the backend seamlessly activates local SQLite + Vector fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET_NAME=voice-recordings

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ENV=development
