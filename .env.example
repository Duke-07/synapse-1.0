# ==========================================
# Synapse-Voice Environment Configuration
# Copy this file to .env and supply your credentials.
# NEVER commit sensitive API keys or secrets to git.
# ==========================================

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com

# --- LLM & RAG Configuration ---
# Choose 'gemini' (default) or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase Database, pgvector & Storage ---
# (If not provided, the backend seamlessly activates local SQLite + Vector fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET_NAME=voice-recordings

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ENV=development
